<plugin>
  <extension point="org.eclipse.core.contenttype.contentTypes">
    <content-type id="com.datasqrl.eclipse.sqrl"
                  name="SQRL Script"
                  base-type="org.eclipse.core.runtime.text"
                  file-extensions="sqrl"
                  priority="normal"/>
    <!-- Only JSON files with sections of a DataSQRL package file, unlike the package.json of npm -->
    <content-type id="com.datasqrl.eclipse.package"
                  name="DataSQRL Package File"
                  base-type="org.eclipse.core.runtime.text"
                  file-extensions="json"
                  priority="high">
      <describer class="com.datasqrl.eclipse.PackageFileDescriber"/>
    </content-type>
    <content-type id="com.datasqrl.eclipse.graphql"
                  name="GraphQL"
                  base-type="org.eclipse.core.runtime.text"
                  file-extensions="graphql,graphqls"
                  priority="low"/>
  </extension>

  <extension point="org.eclipse.ui.editors">
    <editorContentTypeBinding contentTypeId="com.datasqrl.eclipse.sqrl"
                              editorId="org.eclipse.ui.genericeditor.GenericEditor"/>
    <editorContentTypeBinding contentTypeId="com.datasqrl.eclipse.package"
                              editorId="org.eclipse.ui.genericeditor.GenericEditor"/>
    <editorContentTypeBinding contentTypeId="com.datasqrl.eclipse.graphql"
                              editorId="org.eclipse.ui.genericeditor.GenericEditor"/>
  </extension>

  <extension point="org.eclipse.ui.genericeditor.icons">
    <icon contentType="com.datasqrl.eclipse.sqrl" icon="icons/sqrl.png"/>
  </extension>

  <extension point="org.eclipse.tm4e.registry.grammars">
    <grammar scopeName="source.sqrl" path="shared/syntaxes/sqrl.tmLanguage.json"/>
    <scopeNameContentTypeBinding scopeName="source.sqrl" contentTypeId="com.datasqrl.eclipse.sqrl"/>
  </extension>

  <extension point="org.eclipse.tm4e.languageconfiguration.languageConfigurations">
    <languageConfiguration contentTypeId="com.datasqrl.eclipse.sqrl"
                           path="shared/language-configuration.json"/>
  </extension>

  <extension point="org.eclipse.lsp4e.languageServer">
    <server id="com.datasqrl.eclipse.server"
            label="DataSQRL"
            class="com.datasqrl.eclipse.SqrlConnectionProvider"
            singleton="true"/>
    <contentTypeMapping id="com.datasqrl.eclipse.server"
                        contentType="com.datasqrl.eclipse.sqrl"
                        languageId="sqrl"/>
    <contentTypeMapping id="com.datasqrl.eclipse.server"
                        contentType="com.datasqrl.eclipse.package"
                        languageId="json"/>
    <contentTypeMapping id="com.datasqrl.eclipse.server"
                        contentType="com.datasqrl.eclipse.graphql"
                        languageId="graphql"/>
  </extension>

  <!-- The command of the code lenses above test tables, which LSP4E runs by its ID -->
  <extension point="org.eclipse.ui.commands">
    <command id="sqrl.runTests" name="Run DataSQRL Tests">
      <commandParameter id="org.eclipse.lsp4e.command.param"
                        name="command"
                        typeId="org.eclipse.lsp4e.commandParameterType"
                        optional="false"/>
      <commandParameter id="org.eclipse.lsp4e.path.param"
                        name="path"
                        typeId="org.eclipse.lsp4e.pathParameterType"
                        optional="true"/>
    </command>
  </extension>

  <extension point="org.eclipse.ui.handlers">
    <handler commandId="sqrl.runTests" class="com.datasqrl.eclipse.RunTestsHandler"/>
  </extension>

  <extension point="org.eclipse.ui.preferencePages">
    <page id="com.datasqrl.eclipse.preferences"
          name="DataSQRL"
          class="com.datasqrl.eclipse.SqrlPreferencePage"/>
  </extension>

  <extension point="org.eclipse.core.runtime.preferences">
    <initializer class="com.datasqrl.eclipse.SqrlPreferences"/>
  </extension>
</plugin>
