<feature id="com.datasqrl.eclipse.feature"
         label="DataSQRL"
         version="0.1.0.qualifier"
         provider-name="DataSQRL">
  <description url="https://docs.datasqrl.com/docs/editors">
    Support for DataSQRL scripts (.sqrl) from the SQRL compiler: errors as you type, completion,
    navigation, renaming, quick fixes, syntax highlighting, and running tests from code lenses.
  </description>
  <license url="https://www.apache.org/licenses/LICENSE-2.0">
    Apache License, Version 2.0
  </license>
  <requires>
    <import plugin="org.eclipse.lsp4e"/>
    <import plugin="org.eclipse.tm4e.ui"/>
  </requires>
  <plugin id="com.datasqrl.eclipse" version="0.0.0"/>
</feature>
