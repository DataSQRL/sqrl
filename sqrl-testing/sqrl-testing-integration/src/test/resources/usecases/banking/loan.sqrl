IMPORT `banking_catalog`.`sources`;

/** Loan application status updates @financial */
/*+engine(kafka), insert(transaction) */
CREATE TABLE ApplicationUpdates (
  _uuid STRING NOT NULL METADATA FROM 'uuid',
  loan_application_id BIGINT NOT NULL,
  status STRING NOT NULL,
  message STRING COMMENT 'Status message for the applicant @classification=internal',
  event_time TIMESTAMP_LTZ(3) METADATA FROM 'timestamp'
);

/*+engine(kafka) */
CREATE TABLE AddChatMessage (
    _uuid STRING NOT NULL METADATA FROM 'uuid',
    role STRING NOT NULL,
    content STRING NOT NULL COMMENT 'The message text written by the customer @pii=raw',
    name STRING,
    context ROW(`customerid` INT) NOT NULL,
    event_time TIMESTAMP_LTZ(3) METADATA FROM 'timestamp'
);

/** Customer records @pii=raw @classification=confidential */
CustomersStream := SELECT * FROM sources.CustomersStream;
/** Loan applications @financial @classification=internal */
ApplicationsStream := SELECT * FROM sources.ApplicationsStream;
LoanTypesStream := SELECT * FROM sources.LoanTypesStream;

/** Most recent version of each customer @pii=raw @classification=confidential */
Customers := DISTINCT CustomersStream ON id ORDER BY updated_at DESC;
/** Most recent version of each loan application @financial @classification=internal */
Applications := DISTINCT ApplicationsStream ON id ORDER BY updated_at DESC;
LoanTypes := DISTINCT LoanTypesStream ON id ORDER BY updated_at DESC;

Customers.applications := SELECT * FROM Applications a WHERE this.id = a.customer_id ORDER BY a.application_date;

ApplicationUpdates.application := SELECT * FROM Applications a WHERE this.loan_application_id = a.id;
Applications.updates := SELECT * FROM ApplicationUpdates u WHERE this.id = u.loan_application_id ORDER BY u.event_time;

Applications.loanType := SELECT * FROM LoanTypes t WHERE this.loan_type_id = t.id;

Customers.overview := SELECT a.loan_type_id, SUM(a.amount) as total_amount, COUNT(1) as total_loans
                      FROM Applications a WHERE this.id = a.customer_id
                      GROUP BY a.loan_type_id;

/** Status of loan applications @financial @classification=confidential */
ApplicationStatus := SELECT u._uuid, u.status, u.message, u.event_time, a.id, a.customer_id, a.loan_type_id,
                            a.amount, a.duration, t.max_amount, t.min_amount
                     FROM ApplicationUpdates u JOIN Applications FOR SYSTEM_TIME AS OF u.`event_time` a ON a.id = u.loan_application_id
                            JOIN LoanTypes FOR SYSTEM_TIME AS OF u.`event_time` t ON t.id = a.loan_type_id;

--EXPORT ApplicationStatus TO print.status;

/** Alerts for applications outside the loan type limits @financial @classification=confidential */
ApplicationAlert := SUBSCRIBE SELECT _uuid, id, customer_id, loan_type_id, max_amount, min_amount, amount
                    FROM ApplicationStatus a
                    WHERE status = 'underwriting' AND (amount > max_amount OR amount < min_amount);

/** Chat messages of customers @pii=raw */
CustomerChatMessage := SELECT role, content, name, c.context.customerid, event_time AS `timestamp`,
                        _uuid AS uuid
                       FROM AddChatMessage c ORDER BY `timestamp` DESC;

/** Applications of the given customer @financial @classification=internal */
CustomerApplications(customerId BIGINT NOT NULL) := SELECT * FROM Applications WHERE customer_id = :customerId;

_ApplicationsByCustomer := SELECT a.loan_type_id, a.amount, c.id AS customer_id
                           FROM Applications a JOIN Customers c ON a.customer_id = c.id;

/*+declassify(pii) */
/** Loan totals per loan type @financial @classification=confidential */
LoanTotals := SELECT loan_type_id, SUM(amount) AS total_amount, COUNT(*) AS num_loans
              FROM _ApplicationsByCustomer GROUP BY loan_type_id;

/*+declassify(classification) */
/** Number of status updates per loan type @financial @classification=internal */
LoanTypeStatusCounts := SELECT loan_type_id, COUNT(*) AS num_updates
                        FROM ApplicationStatus GROUP BY loan_type_id;

/*+declassify(pii, classification) */
_CustomerNameCounts := SELECT first_name, COUNT(*) AS num_customers FROM Customers GROUP BY first_name;

/** Number of customers per first name */
CustomerNameCounts := SELECT first_name, num_customers FROM _CustomerNameCounts;

-- No doc string: takes the doc string and tags of its base table Customers
CustomersWithEmail := SELECT * FROM Customers WHERE email IS NOT NULL;

/** Large applications of customers with a known last name @financial @classification=confidential @pii=raw */
LargeApplications := SELECT * FROM Applications
                     WHERE amount > 10000 AND customer_id IN (SELECT id FROM Customers WHERE last_name IS NOT NULL);

/*+test */
LoanTypesTest := SELECT COUNT(*) as num_loan_types FROM LoanTypes;

/*+test, declassify(pii) */
/** @financial @classification=confidential */
CustomerApplicationTest := SELECT c.id, c.email, COUNT(*) as num_applications, SUM(a.amount) as total
                           FROM Customers c JOIN Applications a ON c.id = a.customer_id
                           GROUP BY c.id, c.email ORDER BY c.email;

/*+ test */
/** @financial @classification=confidential */
ApplicationAlertTest := SELECT * FROM ApplicationAlert ORDER BY id;
