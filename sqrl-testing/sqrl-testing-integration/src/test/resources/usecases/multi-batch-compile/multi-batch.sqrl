IMPORT tables.sources.Numbers AS Src;

CREATE TABLE TableA (
  val INT
) WITH (
  'connector' = 'print'
);

CREATE TABLE TableB (
  recordCount INT
) WITH (
  'connector' = 'print'
);

INSERT INTO TableA SELECT * FROM Src;

EXPORT Src TO tables.sinks.SinkA;

NEXT_BATCH;

INSERT INTO TableB SELECT * FROM Src;

EXPORT Src TO tables.sinks.SinkB;

NEXT_BATCH;

CREATE TABLE TableC (
  recordCount INT
) WITH (
  'connector' = 'print'
);

INSERT INTO TableC SELECT * FROM Src;
