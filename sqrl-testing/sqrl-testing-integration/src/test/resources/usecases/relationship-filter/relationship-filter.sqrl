/*+primary_key(id) */
Thing := SELECT * FROM (VALUES
    ('a', 'label-a', CAST('2024-01-01 00:00:00' AS TIMESTAMP_LTZ(3))),
    ('b', 'label-b', CAST('2024-01-02 00:00:00' AS TIMESTAMP_LTZ(3))),
    ('c', 'label-c', CAST('2024-01-03 00:00:00' AS TIMESTAMP_LTZ(3)))) AS t (id, label, `timestamp`);

/*+primary_key(id) */
Detail := SELECT * FROM (VALUES
    ('a', 'detail-a'), ('b', 'detail-b'), ('c', 'detail-c')) AS t (id, info);

/*+primary_key(id) */
Tombstone := SELECT * FROM (VALUES ('c')) AS t (id);

-- Nested relationship field on Thing
Thing.detail := SELECT * FROM Detail d WHERE this.id = d.id LIMIT 1;

-- Bind a TIMESTAMP_LTZ parent value in the nested PostgreSQL query.
Thing.relatedByTimestamp := SELECT * FROM Thing other
WHERE this.`timestamp` <= other.`timestamp`
ORDER BY other.`timestamp`;

-- A) clean passthrough -> result keeps `detail`
cleanQuery := SELECT * FROM Thing WHERE label IS NOT NULL;

-- B) subquery filter -> result must also keep `detail`
subqueryQuery := SELECT * FROM Thing
WHERE id NOT IN (SELECT id FROM Tombstone);

-- C) anti-join filter -> result must also keep `detail`
joinQuery := SELECT th.* FROM Thing th
LEFT JOIN Tombstone tomb ON th.id = tomb.id
WHERE tomb.id IS NULL;

-- D) table function ordered by a joined column not in the SELECT list
sortedQuery(minId String NOT NULL) := SELECT th.* FROM Thing th
JOIN Detail d ON th.id = d.id
WHERE th.id >= :minId
ORDER BY d.info DESC;
