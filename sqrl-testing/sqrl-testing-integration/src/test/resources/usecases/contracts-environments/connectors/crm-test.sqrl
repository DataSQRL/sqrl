IMPORT crm.*;

-- The test data carries the event time, so it is a physical column
CREATE TABLE Customers (
  received_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR received_at AS received_at - INTERVAL '1' SECOND
) WITH (
  'connector' = 'filesystem',
  'path' = 'file:///tmp/contracts-environments/customers',
  'format' = 'flexible-json'
) LIKE _Customers_schema;

CREATE TABLE Orders (
  WATERMARK FOR updated_at AS updated_at - INTERVAL '1' SECOND
) WITH (
  'connector' = 'filesystem',
  'path' = 'file:///tmp/contracts-environments/orders',
  'format' = 'flexible-json'
) LIKE _Orders_schema;
