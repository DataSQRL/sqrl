IMPORT tables.kafka.InputTable AS KafkaInput;

_UserTokens :=
  SELECT userid,
         SUM(tokens) AS total_tokens,
         window_end,
         window_time
  FROM TABLE(TUMBLE(TABLE KafkaInput, DESCRIPTOR(event_time), INTERVAL '1' SECOND))
  GROUP BY userid, window_start, window_end, window_time;

/*+maintenance(regular) */
LatestTokens := DISTINCT _UserTokens ON userid ORDER BY window_time DESC;

EXPORT _UserTokens TO tables.iceberg.SinkTable;
