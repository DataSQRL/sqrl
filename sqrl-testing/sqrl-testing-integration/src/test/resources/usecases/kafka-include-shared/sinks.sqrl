/*+engine(kafka) */
CREATE TABLE OrderAudit (
    orderid BIGINT NOT NULL,
    customerid BIGINT NOT NULL,
    event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp'
);

-- An external table, which every deployment that writes it writes into the same topic
CREATE TABLE OrderArchive (
    orderid BIGINT NOT NULL,
    customerid BIGINT NOT NULL,
    event_time TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'kafka',
    'topic' = 'order-archive',
    'properties.bootstrap.servers' = '${KAFKA_BOOTSTRAP_SERVERS}',
    'format' = 'flexible-json'
);
