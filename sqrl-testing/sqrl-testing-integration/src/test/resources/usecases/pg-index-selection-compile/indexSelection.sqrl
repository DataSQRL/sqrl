NoIndexByProductId(productId STRING NOT NULL) := SELECT orderId, amount, createdAt FROM NoIndexes WHERE productId = :productId;
NoIndexByCategory(category STRING NOT NULL) := SELECT orderId, amount, createdAt FROM NoIndexes WHERE category = :category;
