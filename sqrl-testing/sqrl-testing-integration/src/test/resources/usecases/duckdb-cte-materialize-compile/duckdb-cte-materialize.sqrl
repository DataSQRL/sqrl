/*+ row_count(1e9) */
CREATE TABLE TableA (
  tenant_id BIGINT NOT NULL,
  shard INTEGER NOT NULL,
  id BIGINT NOT NULL,
  payload STRING,
  PRIMARY KEY (tenant_id, shard, id) NOT ENFORCED
) WITH (
  'connector' = 'iceberg',
  'catalog-type' = 'hadoop',
  'catalog-name' = 'dummy_catalog',
  'warehouse' = 'sqrl_iceberg_data',
  'format-version' = '2'
);

/*+ row_count(5e8) */
