/* Issue #2506: Postgres uses the generated GIN index only if the query repeats its exact
   to_tsvector expression. TextSearchIndexIT runs these queries against Postgres to check that. */

CREATE TABLE Articles (
  id BIGINT NOT NULL,
  title STRING NOT NULL,
  epoch_timestamp BIGINT NOT NULL,
  createdAt AS COALESCE(TO_TIMESTAMP_LTZ(epoch_timestamp, 3), TIMESTAMP '1970-01-01 00:00:00.000'),
  WATERMARK FOR createdAt AS createdAt
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10',
  'fields.epoch_timestamp.kind' = 'sequence',
  'fields.epoch_timestamp.start' = '1719318565000',
  'fields.epoch_timestamp.end' = '1719319565000'
);

CREATE TABLE Posts (
  id BIGINT NOT NULL,
  title STRING NOT NULL,
  body STRING,
  epoch_timestamp BIGINT NOT NULL,
  createdAt AS COALESCE(TO_TIMESTAMP_LTZ(epoch_timestamp, 3), TIMESTAMP '1970-01-01 00:00:00.000'),
  WATERMARK FOR createdAt AS createdAt
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10',
  'fields.epoch_timestamp.kind' = 'sequence',
  'fields.epoch_timestamp.start' = '1719318565000',
  'fields.epoch_timestamp.end' = '1719319565000'
);

ArticleSearch(query STRING NOT NULL) := SELECT id, title, text_search(:query, title) AS score
                                        FROM Articles
                                        WHERE text_search(:query, title) > 0
                                        ORDER BY score DESC;

PostSearch(query STRING NOT NULL) := SELECT id, title, body, text_search(:query, title, body) AS score
                                     FROM Posts
                                     WHERE text_search(:query, title, body) > 0
                                     ORDER BY score DESC;
