IMPORT tables.*;

Dim := DISTINCT DimStream ON id ORDER BY updated DESC;
Grp := DISTINCT GrpStream ON grp ORDER BY updated DESC;

/*+primary_key(event_id) */
Enriched := SELECT e.*, g.val
FROM Events e
LEFT JOIN Dim FOR SYSTEM_TIME AS OF e.ts d ON d.id = e.id
LEFT JOIN Grp FOR SYSTEM_TIME AS OF e.ts g ON g.grp = d.grp;

Attributed := SELECT event_id, id, ts, val
FROM Enriched
WHERE val IS NOT NULL;

/*+primary_key(val, event_date) */
CountsByVal := SELECT /*+ STATE_TTL('e' = '7d') */ val, CAST(ts AS DATE) AS event_date, COUNT(*) AS cnt
FROM Attributed AS e
GROUP BY val, CAST(ts AS DATE);

/*+test(no_rows) */
TotalsTest := SELECT val, SUM(cnt) AS total
FROM CountsByVal
GROUP BY val;
