{
  "version": "1",
  "enabled-engines": ["vertx", "postgres", "kafka", "flink"],
  "compiler": {
    "tags": {
      "pii": { "values": ["masked", "raw"] },
      "classification": { "values": ["internal", "confidential"] },
      "financial": {},
      "jurisdiction": { "required-columns": { "jurisdiction": "STRING" } }
    }
  },
  "script": {
    "main": "tags.sqrl",
    "include": {
      "banking_catalog": {
        "package": "../banking-shared/package-shared.json"
      }
    }
  }
}
