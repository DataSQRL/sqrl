-- The new script: the watermark of top-event-watermark-ts.sqrl moves from ts to ts2.

CREATE TABLE _Events (
  id INT NOT NULL,
  val BIGINT NOT NULL,
  ts TIMESTAMP_LTZ(3) NOT NULL,
  ts2 TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ts2 AS ts2 - INTERVAL '1' SECOND
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10'
);

-- A Rank, because the order is not by time. It stores the full rows, with ts and ts2.
/*+engine(flink) */
TopEvent := DISTINCT _Events ON id ORDER BY val DESC;
