-- The old script for a removed table: counts the events of each minute, and sums the values of
-- the last event of each id. The name TotalByEvent sorts after EventsPerMinute, so removing it
-- keeps the ids of the window aggregate.

CREATE TABLE _Events (
  id INT NOT NULL,
  val BIGINT NOT NULL,
  ts TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ts AS ts - INTERVAL '1' SECOND
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10'
);

EventsPerMinute := SELECT window_start, window_end, COUNT(*) AS cnt
    FROM TABLE(TUMBLE(TABLE _Events, DESCRIPTOR(ts), INTERVAL '1' MINUTE))
    GROUP BY window_start, window_end;

-- Flink keeps this deduplicate, because the next table reads it.
_LatestEvent := DISTINCT _Events ON id ORDER BY ts DESC;

TotalByEvent := SELECT id, SUM(val) AS total FROM _LatestEvent GROUP BY id;
