-- The new script: adds the table AlertEvents. Its name sorts before EventsPerMinute, so its
-- operators take the ids of the old window aggregate.

CREATE TABLE _Events (
  id INT NOT NULL,
  val BIGINT NOT NULL,
  ts TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ts AS ts - INTERVAL '1' SECOND
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10'
);

EventsPerMinute := SELECT window_start, window_end, COUNT(*) AS cnt
    FROM TABLE(TUMBLE(TABLE _Events, DESCRIPTOR(ts), INTERVAL '1' MINUTE))
    GROUP BY window_start, window_end;

AlertEvents := SELECT id, val FROM _Events WHERE val > 100;
