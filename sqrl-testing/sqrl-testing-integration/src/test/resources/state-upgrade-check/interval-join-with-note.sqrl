-- The new script: the interval join also selects the note of the order.

CREATE TABLE _Events (
  id INT NOT NULL,
  val BIGINT NOT NULL,
  ts TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ts AS ts - INTERVAL '1' SECOND
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10'
);

CREATE TABLE _Orders (
  id INT NOT NULL,
  event_id INT NOT NULL,
  amount BIGINT NOT NULL,
  note STRING NOT NULL,
  ts TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ts AS ts - INTERVAL '1' SECOND
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10'
);

OrderEvents := SELECT e.id, o.amount, o.note
    FROM _Events e JOIN _Orders o
    ON e.id = o.event_id AND o.ts BETWEEN e.ts - INTERVAL '1' MINUTE AND e.ts;
