-- The new script: the window aggregate also keeps the maximum value.

CREATE TABLE _Events (
  id INT NOT NULL,
  val BIGINT NOT NULL,
  ts TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ts AS ts - INTERVAL '1' SECOND
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10'
);

EventsPerMinute := SELECT window_start, window_end, COUNT(*) AS cnt, MAX(val) AS max_val
    FROM TABLE(TUMBLE(TABLE _Events, DESCRIPTOR(ts), INTERVAL '1' MINUTE))
    GROUP BY window_start, window_end;
