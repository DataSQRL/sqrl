-- The old script: keeps the last event of each id, and sums the values of the last events.

CREATE TABLE _Events (
  id INT NOT NULL,
  val BIGINT NOT NULL,
  ts TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ts AS ts - INTERVAL '1' SECOND
) WITH (
  'connector' = 'datagen',
  'number-of-rows' = '10'
);

-- Flink keeps this deduplicate, because the next table reads it.
_LatestEvent := DISTINCT _Events ON id ORDER BY ts DESC;

EventTotal := SELECT id, SUM(val) AS total FROM _LatestEvent GROUP BY id;
