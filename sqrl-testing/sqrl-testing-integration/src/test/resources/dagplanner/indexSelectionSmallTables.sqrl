/* Index selection skips a table that holds at most 100 rows by its definition or by a row_count
   hint (issue #2618). PostgreSQL reads such a table in about one page, and it never analyzes a
   table that small on its own. Without statistics it can probe an index once per row instead of
   building a hash join. Each case reads its own tables, so that their indexes don't interfere. */

CREATE TABLE Events (id BIGINT NOT NULL, status STRING NOT NULL, status_code INT NOT NULL, ts TIMESTAMP_LTZ(3) NOT NULL, WATERMARK FOR ts AS ts) WITH ('connector' = 'datagen', 'number-of-rows' = '10');
EventsLatest := DISTINCT Events ON id ORDER BY ts DESC;

/* The join of the issue: CAST(label AS TEXT) still counts as the column label, but StatusCode holds
   6 rows and gets no index. */
/*+primary_key(code) */
StatusCode := SELECT * FROM (VALUES (0, 'A'), (1, 'B'), (2, 'C'), (3, 'D'), (4, 'E'), (5, 'F')) AS t(code, label);
EventsWithStatus(id BIGINT NOT NULL) := SELECT e.id, e.status, s.code, s.label
  FROM EventsLatest e LEFT JOIN StatusCode s ON s.label = e.status WHERE e.id = :id;

/* A join without a cast: StatusNumber gets no index on num. */
StatusNumber := SELECT * FROM (VALUES (0, 10), (1, 11), (2, 12)) AS t(code, num);
EventsWithNumber(id BIGINT NOT NULL) := SELECT e.id, e.status, s.code
  FROM EventsLatest e LEFT JOIN StatusNumber s ON s.num = e.status_code WHERE e.id = :id;

/* A filter on the small table itself: StatusLabel gets no index on label. */
/*+primary_key(code) */
StatusLabel := SELECT * FROM (VALUES (0, 'A'), (1, 'B')) AS t(code, label);
StatusByLabel(label STRING NOT NULL) := SELECT * FROM StatusLabel WHERE label = :label;

/* A VALUES list of 101 rows is over the limit: StatusLarge gets an index on num. */
StatusLarge := SELECT * FROM (VALUES (0, 1000), (1, 1001), (2, 1002), (3, 1003), (4, 1004), (5, 1005), (6, 1006), (7, 1007), (8, 1008), (9, 1009), (10, 1010), (11, 1011), (12, 1012), (13, 1013), (14, 1014), (15, 1015), (16, 1016), (17, 1017), (18, 1018), (19, 1019), (20, 1020), (21, 1021), (22, 1022), (23, 1023), (24, 1024), (25, 1025), (26, 1026), (27, 1027), (28, 1028), (29, 1029), (30, 1030), (31, 1031), (32, 1032), (33, 1033), (34, 1034), (35, 1035), (36, 1036), (37, 1037), (38, 1038), (39, 1039), (40, 1040), (41, 1041), (42, 1042), (43, 1043), (44, 1044), (45, 1045), (46, 1046), (47, 1047), (48, 1048), (49, 1049), (50, 1050), (51, 1051), (52, 1052), (53, 1053), (54, 1054), (55, 1055), (56, 1056), (57, 1057), (58, 1058), (59, 1059), (60, 1060), (61, 1061), (62, 1062), (63, 1063), (64, 1064), (65, 1065), (66, 1066), (67, 1067), (68, 1068), (69, 1069), (70, 1070), (71, 1071), (72, 1072), (73, 1073), (74, 1074), (75, 1075), (76, 1076), (77, 1077), (78, 1078), (79, 1079), (80, 1080), (81, 1081), (82, 1082), (83, 1083), (84, 1084), (85, 1085), (86, 1086), (87, 1087), (88, 1088), (89, 1089), (90, 1090), (91, 1091), (92, 1092), (93, 1093), (94, 1094), (95, 1095), (96, 1096), (97, 1097), (98, 1098), (99, 1099), (100, 1100)) AS t(code, num);
EventsWithLarge(id BIGINT NOT NULL) := SELECT e.id, e.status, s.code
  FROM EventsLatest e LEFT JOIN StatusLarge s ON s.num = e.status_code WHERE e.id = :id;

/* A row_count hint counts like a VALUES list: Regions gets no index on name. */
/*+row_count(10) */
CREATE TABLE Regions (region_id BIGINT NOT NULL, name STRING NOT NULL, ts TIMESTAMP_LTZ(3) NOT NULL, WATERMARK FOR ts AS ts) WITH ('connector' = 'datagen', 'number-of-rows' = '10');
RegionsByName(name STRING NOT NULL) := SELECT * FROM Regions WHERE name = :name;

/* An index hint still applies to a small table: StatusHinted gets the hash index on label. */
/*+primary_key(code), index(HASH, label) */
StatusHinted := SELECT * FROM (VALUES (0, 'A'), (1, 'B')) AS t(code, label);
StatusHintedByLabel(label STRING NOT NULL) := SELECT * FROM StatusHinted WHERE label = :label;

/* A stream joined with a VALUES list is estimated at about 5 rows, but nothing limits its size:
   PriorityOrders gets an index on customer_id. */
CREATE TABLE Orders (order_id BIGINT NOT NULL, customer_id BIGINT NOT NULL, ts TIMESTAMP_LTZ(3) NOT NULL, WATERMARK FOR ts AS ts) WITH ('connector' = 'datagen', 'number-of-rows' = '10');
/*+engine(flink) */
PriorityOrders := SELECT o.order_id, o.customer_id, o.ts
  FROM Orders o JOIN (VALUES (1), (2), (3), (4), (4)) AS t(customer_id) ON o.customer_id = t.customer_id;
PriorityOrdersByCustomer(customerId BIGINT NOT NULL) := SELECT * FROM PriorityOrders WHERE customer_id = :customerId;
