/*+no_query */
Orders := SELECT order_id, customer_id FROM (VALUES ('O1', 'C1'), ('O2', 'C2')) AS t(order_id, customer_id);

-- Only 'auth' takes a name after the dot: the server has no reader for 'uuid' metadata.
MyOrders(customer_id STRING NOT NULL METADATA FROM 'uuid.x') :=
    SELECT order_id FROM Orders WHERE customer_id = :customer_id;
