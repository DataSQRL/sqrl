# Floating 17-jdk-noble tag pinned by digest: on 2026-11-26 the exact 17.0.21.1_2-jdk-noble tag had no
# arm64 image, and this digest ships the CVE-2026-114938 fix (17.0.21.1+2) on amd64.
FROM eclipse-temurin:17-jdk-noble@sha256:bdd7eeee8f2259194d39a9525f09abfddcb97a7bdc6fcd97de6f83652e80f772

ENV DUCKDB_EXTENSIONS_DIR=/opt/duckdb_extensions

ARG DUCKDB_JDBC_VERSION

# Install DuckDB CLI and pre-install extensions
RUN set -eux; \
    duckdb_jdbc_version="${DUCKDB_JDBC_VERSION:?DUCKDB_JDBC_VERSION build-arg is required}"; \
    duckdb_jdbc_version="${duckdb_jdbc_version%%-*}"; \
    duckdb_cli_version="$(printf '%s' "${duckdb_jdbc_version}" | cut -d. -f1-3)"; \
    export DUCKDB_VERSION="${duckdb_cli_version}"; \
    curl https://install.duckdb.org | sh; \
    /root/.duckdb/cli/${duckdb_cli_version}/duckdb -c "INSTALL iceberg; INSTALL avro; INSTALL httpfs; INSTALL aws; INSTALL cache_httpfs FROM community;"; \
    mkdir -p "${DUCKDB_EXTENSIONS_DIR}"; \
    cp -a /root/.duckdb/extensions/. "${DUCKDB_EXTENSIONS_DIR}/"; \
    rm -rf /root/.duckdb
